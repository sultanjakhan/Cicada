{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cicada",
  "mainBinaryName": "hanni-mvp",
  "version": "0.3.31",
  "identifier": "app.hanni.mvp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cicada",
        "width": 760,
        "height": 720,
        "minWidth": 640,
        "minHeight": 500,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Hanni MVP",
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Cicada",
        "installerIcon": "icons/icon.ico",
        "template": "windows/installer.nsi",
        "languages": [
          "Russian",
          "English"
        ],
        "installerHooks": "windows/update-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OTJERUM0RDMwODI1RTQKUldUa0pRalR4TjZTaENwTk5HNWZOWVhJOEUyaTI1cHpuTjA0dmg5S0lSWVlxR3NrNFBYQlZjM0kK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
