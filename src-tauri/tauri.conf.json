{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanni MVP",
  "mainBinaryName": "hanni-mvp",
  "version": "0.2.1",
  "identifier": "app.hanni.mvp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Hanni MVP",
        "width": 760,
        "height": 720,
        "minWidth": 640,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Hanni MVP",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Hanni MVP",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Russian",
          "English"
        ]
      }
    }
  }
}
