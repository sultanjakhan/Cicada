#!/bin/sh
# Prevent old, unsanitized history from being published again from a local branch.
hook_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  python -B "$hook_dir/../scripts/check-public-history.py" --ref "$local_sha" || exit 1
done
