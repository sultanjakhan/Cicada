{
  "name": "cicada",
  "version": "0.3.26",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "check:vendor": "node scripts/check-vendor.mjs",
    "check:privacy": "python -B scripts/check-private-data.py",
    "package:windows": "powershell -NoProfile -File scripts/package-windows.ps1",
    "tauri": "tauri",
    "package:mac": "python3 scripts/package-macos.py",
    "check:history": "python -B scripts/check-public-history.py"
  },
  "dependencies": {
    "@editorjs/checklist": "1.6.0",
    "@editorjs/code": "2.9.4",
    "@editorjs/delimiter": "1.4.2",
    "@editorjs/editorjs": "2.31.0-rc.2",
    "@editorjs/header": "2.8.8",
    "@editorjs/inline-code": "1.5.2",
    "@editorjs/list": "2.0.9",
    "@editorjs/marker": "1.4.0",
    "@editorjs/quote": "2.7.6",
    "dompurify": "3.4.14",
    "editorjs-drag-drop": "1.1.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "jsdom": "29.1.1",
    "vite": "8.3.0"
  },
  "license": "MIT"
}
