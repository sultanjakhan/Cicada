{
  "$schema": "../sync-relay/node_modules/wrangler/config-schema.json",
  "name": "hanni-mvp-updates-v1",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "../.local/update-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  }
}
